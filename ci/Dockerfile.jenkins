FROM jenkins/jenkins:lts-jdk17

USER root

# Docker CLI + plugin Compose v2 — usados pelo pipeline para buildar
# imagens e subir os ambientes de Homologacao/Producao.
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc && \
    chmod a+r /etc/apt/keyrings/docker.asc && \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
        > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

USER jenkins

# Plugins pre-instalados — evita baixar os "suggested plugins" em runtime
# (lento e instavel na VM com pouca RAM).
COPY plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt

# Scripts de inicializacao: rodam no boot do Jenkins e criam o usuario
# admin e o job do pipeline, dispensando o assistente inicial.
COPY init.groovy.d/ /usr/share/jenkins/ref/init.groovy.d/
